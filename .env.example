# Copy to .env to override defaults used by docker-compose.yml.

# PostgreSQL
POSTGRES_DB=streampulse
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=streampulse
POSTGRES_HOST_PORT=5432

# Kafka (KRaft). Host clients use localhost:29092, containers use kafka:9092.
KAFKA_PARTITIONS=6
KAFKA_RETENTION_MS=86400000

# Simulator defaults (can also be changed live through POST /simulation/start)
SIM_AUTOSTART=true
SIM_DEVICES=20
SIM_RATE=100
SIM_SEED=42
SIM_ANOMALY_RATE=2.0
SIM_INTENSITY=1.0

# Spark resources
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_DRIVER_MEMORY=1g

# Streaming windows
WINDOW_DURATION=1 minute
WINDOW_SLIDE=15 seconds
WATERMARK_DELAY=2 minutes

# Published ports
API_PORT=8000
DASHBOARD_PORT=8080
SPARK_UI_PORT=8081
